# Copy to .env (or set as real environment variables in your host) and fill in.
APP_ENV=development                 # set to "production" to enforce JWT_SECRET_KEY strength
JWT_SECRET_KEY=change-this-to-a-long-random-value-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./is_reco.db  # or postgresql://user:pass@host:5432/dbname (needs requirements-postgres.txt)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
EMBEDDING_MODE=hybrid                # "hybrid" (auto-falls-back if sentence-transformers isn't installed) | "tfidf_only"
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RATE_LIMIT_ENABLED=true              # set to "false" only for automated tests
LOG_LEVEL=INFO

# Seed script bootstrap (see app/seed.py docstring)
SEED_DEMO_ACCOUNTS=true              # set "false" in production to skip officer/auditor demo accounts
ADMIN_BOOTSTRAP_EMAIL=admin@isreco.gov.in
ADMIN_BOOTSTRAP_PASSWORD=Admin@123    # MUST override this for any real deployment
